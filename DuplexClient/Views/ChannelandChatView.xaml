<UserControl x:Class="DuplexClient.Views.ChatShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="520" Width="820">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: channel sidebar -->
        <DockPanel Grid.Column="0" Margin="10">
            <TextBlock DockPanel.Dock="Top" Text="Channels" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
            <Button x:Name="SignOutButton" DockPanel.Dock="Bottom" Content="Sign Out" Click="SignOutButton_Click" Height="28" Margin="0,10,0,0"/>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <TextBox x:Name="NewChannelNameTextBox" Height="26" Margin="0,0,0,5"/>
                <Button x:Name="CreateChannelButton" Content="Create Channel" Height="26" Click="CreateChannelButton_Click"/>
                <TextBlock x:Name="ChannelListStatusTextBlock" Foreground="Red" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>

            <ListBox x:Name="ChannelListBox" SelectionChanged="ChannelListBox_SelectionChanged"/>
        </DockPanel>

        <!-- Right: placeholder until a channel is selected -->
        <Grid Grid.Column="1">
            <TextBlock x:Name="PlaceholderText"
                       Text="Select a channel to get started"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="16"/>

            <Grid x:Name="ChannelContentPanel" Margin="20" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <TextBlock x:Name="CurrentChannelTextBlock" DockPanel.Dock="Top" Text="Channel" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="LeaveChannelButton" Content="Leave Channel" Height="32" Width="120" Margin="0,0,10,0" Click="LeaveChannelButton_Click"/>
                        <Button x:Name="ShareFileButton" Content="Share File" Height="32" Width="100" Margin="0,0,10,0" Click="ShareFileButton_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="SharedFilesStatusTextBlock" DockPanel.Dock="Bottom" Foreground="Red" TextWrapping="Wrap" Margin="0,5,0,0"/>

                    <Grid DockPanel.Dock="Bottom" Margin="0,10,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MessageTextBox" Grid.Column="0" Height="30" Margin="0,0,10,0" KeyDown="MessageTextBox_KeyDown"/>
                        <Button x:Name="SendMessageButton" Grid.Column="1" Content="Send" Width="80" Height="30" Click="SendMessageButton_Click"/>
                    </Grid>

                    <ListBox x:Name="MessagesListBox"/>
                </DockPanel>

                <DockPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock DockPanel.Dock="Top" Text="Members" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ListBox x:Name="MembersListBox" DockPanel.Dock="Top" Height="180" Margin="0,0,0,10"
                             MouseDoubleClick="MembersListBox_MouseDoubleClick"/>
                    <TextBlock DockPanel.Dock="Top" Text="Shared Files" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ListBox x:Name="SharedFilesListBox" MouseDoubleClick="SharedFilesListBox_MouseDoubleClick"/>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>