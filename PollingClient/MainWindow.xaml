<Window x:Class="PollingClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PollingClient"
        mc:Ignorable="d"
        Title="Chat Server - Sign In" 
        Height="460" 
        Width="620"
        WindowStartupLocation="CenterScreen"
        Closed="MainWindow_Closed">

    <!-- Main container for the different application views -->
    <Grid Margin="30">

        <!-- ***SIGN-IN VIEW*** -->
        <Grid x:Name="SignInView">
            
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Application Heading -->
            <TextBlock Grid.Row="0"
                       Text="Chat Server"
                       FontSize="28"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,5"/>
            
            <!-- Sign-in Instructions -->
            <TextBlock Grid.Row="1"
                       Text="Enter a user ID to sign in."
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>
            
            <!-- Sign-in Controls -->
            <StackPanel Grid.Row="2"
                        Width="300"
                        VerticalAlignment="Top">
                
                <!-- User ID Label -->
                <TextBlock Text="User ID"
                           Margin="0,0,0,5"/>
                
                <!-- User enters their chosen ID here -->
                <TextBox x:Name="UserIdTextBox"
                         Height="34"
                         FontSize="14"
                         Padding="6"
                         Margin="0,0,0,12"/>
                
                <!-- Sends sign-in request to server -->
                <Button x:Name="SignInButton"
                        Content="Sign In"
                        Height="36"
                        FontSize="14"
                        Margin="0,0,0,12"
                        Click="SignInButton_Click"/>
                
                <!-- Displays sign-in result -->
                <TextBlock x:Name="StatusTextBlock"
                           Text=""
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MinHeight="30"/>
                
            </StackPanel>
        </Grid>
        
        <!-- ***CHANNEL LIST VIEW*** -->
        <!-- This is hidden until user successfully signed in -->
        <Grid x:Name="ChannelListView"
              Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Channel list heading -->
            <TextBlock Grid.Row="0"
                       Text="Available Channels"
                       FontSize="26"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,5"/>
            
            <!-- Instructions -->
            <TextBlock Grid.Row="1"
                       Text="Select a channel to join."
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>
            
            <!-- Displays channels returned by server -->
            <ListBox x:Name="ChannelListBox"
                     Grid.Row="2"
                     MinHeight="180"
                     FontSize="15"
                     Margin="0,0,0,15"/>
            
            <!-- Input used when creating a new channel -->
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,5">
                
                <!-- Label for the new channel name -->
                <TextBlock Text="New Channel:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                
                <!-- User enters the desired channel name here -->
                <TextBox x:Name="NewChannelNameTextBox"
                         Width="220"
                         Height="32"
                         FontSize="14"
                         Padding="5"/>
                
            </StackPanel>
            
            <!-- Channel actions -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,10">
                
                <!-- Joins the currently selected channel -->
                <Button x:Name="JoinChannelButton"
                        Content="Join Channel"
                        Width="140"
                        Height="36"
                        Margin="5"
                        Click="JoinChannelButton_Click"/>
                
                <!-- Creates a new channel using the entered name -->
                <Button x:Name="CreateChannelButton"
                        Content="Create Channel"
                        Width="140"
                        Height="36"
                        Margin="5"
                        Click="CreateChannelButton_Click"/>
                
            </StackPanel>
            
            <!-- Displays channel-list messages -->
            <TextBlock x:Name="ChannelListStatusTextBlock"
                       Grid.Row="5"
                       Text=""
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MinHeight="25"/>

        </Grid>
        
        <!-- ***CHANNEL CONVERSATION VIEW*** -->
        <!-- This is hidden until the user successfully joins a channel-->
        <Grid x:Name="ChannelConversationView"
              Visibility="Collapsed">
            
            <!-- Split the conversation screen into main areas -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Shows the name of the channel currently loaded -->
            <TextBlock x:Name="CurrentChannelTextBlock"
                       Grid.Row="0"
                       Grid.ColumnSpan="2"
                       Text="Channel"
                       FontSize="26"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,15"/>
            
            <!-- Main channel conversation -->
            <GroupBox Grid.Row="1"
                      Grid.Column="0"
                      Header="Conversation"
                      Margin="0,0,10,10">
                
                <!-- Messages will later appear here -->
                <ListBox x:Name="MessagesListBox"
                         FontSize="14"/>
            </GroupBox>
            
            <!-- Right-side information -->
            <Grid Grid.Row="1"
                  Grid.Column="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Current members of the channel -->
                <GroupBox Grid.Row="0"
                          Header="Members"
                          Margin="0,0,0,5">

                    <ListBox x:Name="MembersListBox"/>
                </GroupBox>
                
                <!-- Files shared into the channel -->
                <GroupBox Grid.Row="1"
                          Header="Shared Files"
                          Margin="0,5,0,10">

                    <ListBox x:Name="SharedFilesListBox"/>
                </GroupBox>
                
            </Grid>
            
            <!-- Message input area -->
            <Grid Grid.Row="2"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  Margin="0,0,0,10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- User will type public channel messages here -->
                <TextBox x:Name="MessageTextBox"
                         Grid.Column="0"
                         Height="36"
                         FontSize="14"
                         Padding="6"
                         Margin="0,0,10,0"/>
                
                <!-- ***Will later send the typed message -->
                <Button x:Name="SendMessageButton"
                        Grid.Column="1"
                        Content="Send"
                        Width="100"
                        Height="36"/>
                
            </Grid>
            
            <!-- Bottom channel controls -->
            <StackPanel Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">
                
                <!-- ***Will later allow a file to be shared -->
                <Button x:Name="ShareFileButton"
                        Content="Share File"
                        Width="120"
                        Height="36"
                        Margin="5"/>
                
                <!-- Leaves current channel and returns to channel list -->
                <Button x:Name="LeaveChannelButton"
                        Content="Leave Channel"
                        Width="120"
                        Height="36"
                        Margin="5"
                        Click="LeaveChannelButton_Click"/>
                
            </StackPanel>
            
        </Grid>
        
    </Grid>
</Window>