<UserControl x:Class="PollingClient.Views.SignInView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="460" Width="620">

    <StackPanel Margin="30" VerticalAlignment="Center">
        <TextBlock Text="Welcome to DC2" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
        <TextBox x:Name="UserIdTextBox" Height="30" Margin="0,0,0,10" Text="Enter your UserID"/>
        <Button x:Name="SignInButton" Content="Sign In" Height="32" Width="100" Click="SignInButton_Click"/>
    </StackPanel>
</UserControl>
